                ]
              }
            }
          ]
        },
        {
          "name": "Erro 422 — check-in a 2 km da feira",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{locale}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}/check-in",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "{{taskId}}",
                "check-in"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": {{longeLat}},\n  \"longitude\": {{longeLng}},\n  \"accuracyMeters\": 20\n}"
            },
            "description": "A cerca virtual é da feira (raio de 250 m mais a tolerância de precisão): a 2 km o check-in é recusado (RN-05)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422', () => pm.expect(pm.response.code).to.be.oneOf([422]));",
                  "pm.test('Problem Details com code CHECKIN_OUT_OF_RANGE', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json().code).to.eql('CHECKIN_OUT_OF_RANGE');",
                  "  pm.expect(pm.response.json().requestId).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
