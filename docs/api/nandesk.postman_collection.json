                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{colaboradoraEmail}}\",\n  \"password\": \"{{senha}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', r.accessToken);",
                  "pm.test('token de acesso', () => pm.expect(r.accessToken).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Renovar sessão (cookie nd_refresh)",
