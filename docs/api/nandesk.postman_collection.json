                "exec": [
                  "pm.test('status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Snapshot da feira (guarda o ETag)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{locale}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/markets/{{marketSlug}}/snapshot",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "markets",
                "{{marketSlug}}",
                "snapshot"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "pm.collectionVariables.set('snapshotEtag', pm.response.headers.get('ETag'));",
                  "pm.test('tem ETag', () => pm.expect(pm.response.headers.get('ETag')).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Snapshot revalidado (304)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{locale}}"
              },
              {
                "key": "If-None-Match",
                "value": "{{snapshotEtag}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/markets/{{marketSlug}}/snapshot",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "markets",
                "{{marketSlug}}",
                "snapshot"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Com o ETag salvo no passo anterior, o servidor responde 304 sem corpo (RF-36)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 304', () => pm.expect(pm.response.code).to.be.oneOf([304]));"
                ]
              }
            }
          ]
        },
