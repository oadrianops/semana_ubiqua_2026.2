        {
          "name": "Tarefas disponíveis",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{locale}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks/available?market={{marketSlug}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "available"
              ],
              "query": [
                {
                  "key": "market",
                  "value": "{{marketSlug}}"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "const r = pm.response.json();",
                  "const t = r.items.find((x) => x.type === 'UPDATE_STALL' && x.stall);",
                  "pm.test('há tarefa de atualização aberta', () => pm.expect(t).to.be.an('object'));",
                  "pm.collectionVariables.set('taskId', t.publicId);",
                  "pm.collectionVariables.set('taskStallId', t.stall.publicId);",
                  "pm.collectionVariables.set('stallVersion', t.stall.version);"
                ]
              }
            }
          ]
        },
        {
          "name": "Aceitar tarefa (passo 1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{locale}}"
              }
