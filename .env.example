# Copie para .env e ajuste. Nunca versione o .env (está no .gitignore). Anexo B da especificação, adaptado:
# domínio nandesk.com.br, chaves JWT por variável (PEM) para o Coolify, e-mail e seed opcionais.

# ===== Banco (MySQL) =====
MYSQL_DATABASE=nandesk
MYSQL_USER=nandesk_app
MYSQL_PASSWORD=troque-me
MYSQL_ROOT_PASSWORD=troque-me-root
# Para a API rodando fora do Docker (IDE / ./mvnw):
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/nandesk
SPRING_DATASOURCE_USERNAME=nandesk_app
SPRING_DATASOURCE_PASSWORD=troque-me

# ===== Aplicação =====
SPRING_PROFILES_ACTIVE=dev
APP_PUBLIC_BASE_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_STORAGE_LOCAL_PATH=./data/uploads

# ===== Segurança =====
# Chaves do JWT: gere com infra/scripts/gen-jwt-keys.sh. Use OU os caminhos OU o conteúdo PEM (multilinha).
# Sem nenhuma das duas, a API gera um par efêmero (as sessões caem a cada reinício; só para dev).
APP_JWT_ISSUER=nandesk
APP_JWT_AUDIENCE=nandesk-web
APP_JWT_KEY_ID=2026-10
APP_JWT_PRIVATE_KEY_PATH=
APP_JWT_PUBLIC_KEY_PATH=
APP_JWT_PRIVATE_KEY=
APP_JWT_PUBLIC_KEY=
# 32 bytes em Base64 para cifrar a chave PIX (RN-22): openssl rand -base64 32
APP_CRYPTO_PIX_KEY=
# true em produção (HTTPS)
APP_REFRESH_COOKIE_SECURE=false

# ===== E-mail =====
# false: sem SMTP, as contas novas entram verificadas (ADR-0017). true: envia pelo SMTP abaixo.
APP_MAIL_ENABLED=true
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_STARTTLS=false
APP_MAIL_FROM=nao-responda@nandesk.com.br
APP_CONTACT_EMAIL=contato@nandesk.com.br

# ===== Push (VAPID) — gerar com infra/scripts/gen-vapid-keys.sh =====
APP_PUSH_VAPID_PUBLIC_KEY=
APP_PUSH_VAPID_PRIVATE_KEY=
APP_PUSH_VAPID_SUBJECT=mailto:contato@nandesk.com.br

# ===== Seed de demonstração (boxes e preços fictícios) =====
# dev: ligado por padrão. Produção: só para a demonstração do hackathon (ADR-0017).
APP_SEED_ENABLED=true
# Senha das contas de teste (moderador@ e colaboradores @nandesk.local), mínimo 8 caracteres.
SEED_DEFAULT_PASSWORD=troque-me-dev
# Senha só da conta admin@nandesk.local (mínimo 12). Vazio = mesma das contas de teste.
SEED_ADMIN_PASSWORD=

# ===== Frontend (config.js gerado na inicialização do contêiner web) =====
WEB_APP_NAME=NANDESK
WEB_API_BASE_URL=/api
# Porcentagem de sessões que enviam métricas de campo (web-vitals)
WEB_VITALS_SAMPLE_RATE=0.1
# Vazio = OpenStreetMap. Ao trocar o provedor de tiles, ajuste o img-src em frontend/nginx/security-headers.conf.
WEB_MAP_TILE_URL=
WEB_MAP_ATTRIBUTION=© OpenStreetMap contributors
# Vazio = rota pelo Google Maps com {lat},{lng}
WEB_DIRECTIONS_URL_TEMPLATE=
WEB_CONTACT_EMAIL=contato@nandesk.com.br
# Faixa "Dados de demonstração" no topo do app
WEB_DEMO_NOTICE=true

# ===== Observabilidade (perfil observability) =====
GRAFANA_ADMIN_PASSWORD=troque-me
