{
  "name": "nandesk-web",
  "private": true,
  "version": "1.0.0",
  "description": "NANDESK — PWA das feiras de Belém (Ver-o-Peso e Feira da 25)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "i18n:check": "vitest run src/shared/i18n/i18n-parity.test.ts",
    "size": "size-limit && node scripts/check-chunks.mjs",
    "e2e": "playwright test",
    "lhci": "lhci autorun",
    "api:generate": "openapi-typescript ../docs/api/openapi.json -o src/shared/api/schema.d.ts",
    "design:detect": "impeccable detect src",
    "ci": "npm run lint && npm run typecheck && npm run coverage && npm run build && npm run size"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@hookform/resolvers": "5.9.2",
    "@tanstack/query-async-storage-persister": "5.104.5",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-query-persist-client": "5.104.5",
    "i18next": "26.5.3",
    "i18next-browser-languagedetector": "8.2.1",
    "idb-keyval": "6.3.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.60.0",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-i18next": "17.1.0",
    "react-leaflet": "5.0.0",
    "react-router": "7.18.4",
    "web-vitals": "6.2.3",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "14.2.0",
    "@size-limit/preset-app": "14.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "impeccable": "4.7.0",
    "jsdom": "30.1.3",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "size-limit": "14.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "overrides": {
    "estimo": {
      "nanoid": "^5.1.11"
    },
    "tmp": "^0.2.6",
    "uuid": "^11.1.1"
  }
}
