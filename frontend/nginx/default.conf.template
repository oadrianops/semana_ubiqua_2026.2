# Nginx do contêiner web (seção 16.4). Variáveis ${API_*} preenchidas pelo envsubst da imagem oficial na
# inicialização (NGINX_ENVSUBST_FILTER=^API_); as variáveis do próprio Nginx ($uri etc.) ficam intactas.

server_tokens off;

# O proxy resolve "api" na hora da requisição (DNS interno do Docker), então o web sobe mesmo antes da API.
resolver 127.0.0.11 valid=10s ipv6=off;

map $http_x_request_id $nd_request_id {
    default $http_x_request_id;
    ""      $request_id;
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;
    client_max_body_size 6m;

    # Arquivos pré-comprimidos no build (.gz) e JSON da API comprimido na hora.
    gzip_static on;
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types application/json application/problem+json application/javascript text/css text/plain image/svg+xml application/manifest+json;

    set $api_upstream ${API_UPSTREAM};
    set $api_health_upstream ${API_HEALTH_UPSTREAM};

    # Saúde do contêiner web (healthcheck da imagem).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Saúde da API para o proxy do Coolify e o smoke test: só /actuator/health, nada mais da porta de gestão.
    location = /actuator/health {
        access_log off;
        proxy_pass $api_health_upstream/actuator/health;
        proxy_set_header Host $host;
    }

    # Notificações em tempo real (SSE): sem buffer e com conexão longa.
    location = /api/v1/me/notifications/stream {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Request-Id $nd_request_id;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        gzip off;
    }

    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Atrás do proxy do Coolify o TLS termina antes; repassa o esquema original (ou http, sem proxy).
        proxy_set_header X-Forwarded-Proto $nd_forwarded_proto;
        proxy_set_header X-Request-Id $nd_request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        # ETag, Cache-Control e If-None-Match passam sem alteração (snapshot das feiras — RF-36).
    }

    # Arquivos com hash no nome: cache de um ano.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Sempre revalidados: a versão nova do app chega na próxima visita.
    location ~ ^/(index\.html|sw\.js|manifest\.webmanifest|config\.js|registerSW\.js)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location ~ ^/(brand|screenshots)/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=604800" always;
        try_files $uri =404;
    }

    location = /robots.txt {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=86400" always;
        try_files $uri =404;
    }

    # SPA: qualquer outra rota abre o index.html.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}

map $http_x_forwarded_proto $nd_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}
